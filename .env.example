# ============================================================
# Chakravyuh Rakshak — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://chakravyuh:chakravyuh@localhost:5432/chakravyuh_rakshak
DATABASE_SYNC_URL=postgresql://chakravyuh:chakravyuh@localhost:5432/chakravyuh_rakshak

# --- Redis (cache / pub-sub / queue — NOT a system of record) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Blockchain (Ethereum-compatible) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=31337

# --- SMS (Twilio) ---
SMS_API_KEY=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- Web Push (FCM / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chakravyuhrakshak.org

# --- AI / LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Geocoding (Nominatim) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Satellite Data ---
# Leave empty to use demo mode
NASA_EARTHDATA_TOKEN=
NOAA_API_KEY=

# --- IPFS (optional — content-addressed blockchain payloads) ---
IPFS_API_URL=
IPFS_API_KEY=

# --- Feature Flags ---
DEMO_MODE=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=chakravyuh-rakshak
